{
	"schemaVersion": 1,
	"id": "nerfed",
	"version": "${version}",
	"name": "Nerfed",
	"description": "This mod adds Debufs and Nerfs to make your minecraft game funnier!",
	"authors": [
		"Da5h1n"
	],
	"contact": {
		"homepage": "https://your-site-or-modrinth-page",
		"sources": "https://github.com/Da5h1n/Nerfed",
		"issues": "https://github.com/Da5h1n/Nerfed/issues"
	},
	"license": "All-Rights-Reserved",
	"icon": "assets/nerfed/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"uk.da5h1n.nerfed.Nerfed"
		],
		"client": [
			"uk.da5h1n.nerfed.NerfedClient"
		],
		"fabric-datagen": [
			"uk.da5h1n.nerfed.NerfedDataGenerator"
		],
		"voicechat": [
			"uk.da5h1n.nerfed.client.NerfedVoicechatPlugin"
		]
	},
	"mixins": [
		"nerfed.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "${minecraft_compat}",
		"java": ">=25",
		"fabric-api": "*"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.discord": "https://discord.gg/your-invite"
			},
			"update_checker": false
		}
	},
	"suggests": {
		"voicechat": "*",
		"modmenu": "*"
	}
}